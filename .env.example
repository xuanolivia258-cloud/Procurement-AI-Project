# Login switch: disabled = direct access for testing; w3 = show W3 sign-in and require a session.
# After changing this in .env, recreate containers: docker compose up -d --force-recreate backend frontend
AUTH_MODE=disabled
LOCAL_ACTOR_ID=local-test-user
LOCAL_ACTOR_NAME=Local Test User
SITE_URL=http://localhost:8080/ai_procurement
# Use 0.0.0.0 when the HTTPS Nginx gateway runs on another server.
# Restrict inbound access to the gateway/internal network at the firewall.
FRONTEND_BIND_HOST=127.0.0.1
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,ai4news.rnd.huawei.com,cari.rnd.huawei.com
SESSION_SECRET=replace-with-at-least-64-random-characters
SESSION_COOKIE_NAME=cari_session
SESSION_COOKIE_PATH=/ai_procurement
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
W3_CLIENT_ID=replace-with-w3-client-id
W3_CLIENT_SECRET=replace-with-w3-client-secret
W3_AUTHORIZE_URL=https://uniportal.huawei.com/saaslogin1/oauth2/authorize
W3_ACCESS_TOKEN_URL=https://uniportal.huawei.com/saaslogin1/oauth2/accesstoken
W3_REFRESH_TOKEN_URL=https://uniportal.huawei.com/saaslogin1/oauth2/refreshtoken
W3_USERINFO_URL=https://uniportal.huawei.com/saaslogin1/oauth2/userinfo
W3_LOGOUT_URL=https://uniportal.huawei.com/saaslogin1/oauth2/logout
W3_SCOPE=base.profile
W3_REDIRECT_URI=https://ai4news.rnd.huawei.com/ai_procurement/authorize
W3_REQUEST_TIMEOUT_SECONDS=10
W3_VERIFY_SSL=true
W3_DEFAULT_ROLE=admin
DATABASE_URL=sqlite:///./data/procurement.db
EXCHANGE_RATE_API_URL=https://apig.his.huawei.com/api/idata/fin/v2/projects/com.huawei.caplatform/getBatchRatemsRateList
EXCHANGE_RATE_TENANT_ID=replace-with-32-character-enterprise-tenant-id
EXCHANGE_RATE_RATE_TYPE=SPOT-SAFE
EXCHANGE_RATE_TIMEOUT_SECONDS=10
EXCHANGE_RATE_LOOKBACK_DAYS=7
EXCHANGE_RATE_CACHE_SECONDS=1800
EXCHANGE_RATE_STALE_SECONDS=86400
EXCHANGE_RATE_IAM_TOKEN_CACHE_SECONDS=300
EXCHANGE_RATE_IAM_TOKEN_URL=https://iam.his-op.huawei.com/iam/auth/token
EXCHANGE_RATE_IAM_ACCOUNT=replace-with-api-integration-account
EXCHANGE_RATE_IAM_SECRET=replace-with-api-integration-account-secret
EXCHANGE_RATE_IAM_PROJECT_ID=replace-with-project-id
EXCHANGE_RATE_IAM_ENTERPRISE_ID=replace-with-enterprise-id
ERROR_LOG_FILE=data/logs/backend-errors.log
ACCESS_LOG_FILE=data/logs/backend-access.log
OPERATION_LOG_FILE=data/logs/backend-operations.log
INTEGRATION_LOG_FILE=data/logs/backend-integrations.log
INTEGRATION_LOG_RESPONSE_MAX_CHARS=2000
ERROR_LOG_MAX_BYTES=5000000
ERROR_LOG_BACKUP_COUNT=5
